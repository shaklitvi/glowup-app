{
  "name": "glowup-app",
  "version": 2,
  "public": true,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "env": {
    "HUGGING_FACE_API_KEY": "@hugging_face_api_key"
  },
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
